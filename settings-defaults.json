{
  "version": 1,
  "preferences": {
    "theme": "dark",
    "accent": "#8aa4ff",
    "fontSize": 14,
    "fontFamily": "JetBrains Mono",
    "lineHeight": 24,
    "tabSize": 2,
    "insertSpaces": true,
    "wordWrap": false,
    "minimap": true,
    "lineNumbers": true,
    "bracketColors": true,
    "indentGuides": true,
    "stickyScroll": true,
    "renderWhitespace": "selection",
    "cursorStyle": "line",
    "cursorBlinking": "smooth",
    "smoothScrolling": true,
    "autoClosingBrackets": true,
    "autoComplete": true,
    "codePrediction": true,
    "predictionModel": "",
    "parameterHints": true,
    "formatOnPaste": true,
    "formatOnSave": false,
    "fixIndentationOnSave": false,
    "autoSave": true,
    "trimWhitespace": false,
    "finalNewline": true,
    "restoreSession": true,
    "compact": false,
    "reducedMotion": false,
    "showPanel": true,
    "confirmDelete": true,
    "locale": "en"
  },
  "chat": {
    "provider": "api",
    "model": "gpt-6.1-sol",
    "tone": "sparkle",
    "maxOutput": 6000,
    "connectionSelected": false
  }
}
