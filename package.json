{
  "name": "bluegay",
  "version": "1.0.5",
  "private": true,
  "description": "BlueGay desktop IDE — an unofficial parody of BlueJ IDE",
  "scripts": {
    "preview": "node serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.cjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "build:diagnostics": "node scripts/build-diagnostics.mjs",
    "build:previews": "node scripts/build-previews.mjs"
  },
  "devDependencies": {
    "@astral-sh/ruff-wasm-web": "0.17.1",
    "@tauri-apps/cli": "^2.0.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.11.2",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "6.4.299",
    "smol-toml": "1.9.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-java": "0.23.5",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReviveRC/BlueGay.git"
  }
}
