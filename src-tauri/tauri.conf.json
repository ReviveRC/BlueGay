{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlueGay",
  "version": "1.0.5",
  "identifier": "app.bluegay.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "node serve.mjs",
    "beforeBuildCommand": "node scripts/build-assets.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BlueGay",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 540,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; frame-src 'self' http://127.0.0.1:*; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/pride-icon.png",
      "icons/pride-icon.ico"
    ]
  }
}
